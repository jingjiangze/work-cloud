# Python Virtual Environment
.venv/
env/
venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.pytest_cache/
nosetests.xml
coverage.xml

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env

# IDE files
.idea/
*.iml
*.pyc

# Cython debug symbols
cython_debug/

# 用户配置（含凭据，禁止入库）；样例文件除外
user/*
!user/example.json

# 运行时产物（状态/日志/报告历史）
data/
logs/
reports/
dashboard/secret_key.txt
dashboard/password.txt

# WorkBuddy session data (not project code)
.workbuddy/
